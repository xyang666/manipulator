  --checkpoint-root /root/autodl-tmp/manipulator/checkpoints/phase1 \
  --result-root ../results/phase1 \
  --output ../results/phase1/manifest.json

# 单任务示例（Ours-Full / curriculum / seed 11）：
.venv/bin/python -u train.py \
  --seed 11 --run_name ours_full/curriculum/seed_11 \
  --save_path /root/autodl-tmp/manipulator/checkpoints/phase1 \
  --scene_json results/ewalker_scenes/curriculum/train.json \
  --val_json results/ewalker_scenes/curriculum/validation.json \
  --n_envs 32 --grad_steps 8 --val_every_steps 25000 --val_scenes 40 \
  --agent_type structured --lambda_dyn 1.0 \
  --task_scale 1.0 --nullspace_scale 0.5 \
  --hidden_dims 256,256 --n_critics 5 \
  --episode_len 500 --batch_size 256 --start_steps 10000 --buffer_size 500000 \
  --lr 3e-4 --tau 0.005 --alpha 0.1 \
  --w_track 12.0 --w_obs 5.0 --w_collision 100.0 \
  --success_bonus 50.0 --d_safe 0.06 \
  --cost_scale 1.0 --cost_limit 0.1 \
  --reward_scale 1.0 --reward_min -10.0

