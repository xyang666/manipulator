  <link name="ewalker_tcp">
    <visual><origin xyz="0 0 -0.07"/><geometry><cylinder radius="0.075" length="0.14"/></geometry><material name="lee_gold"/></visual>
    <collision><origin xyz="0 0 -0.07"/><geometry><cylinder radius="0.075" length="0.14"/></geometry></collision>
  </link>
  <joint name="ewalker_tcp_joint" type="fixed">
    <origin xyz="0 0 0.32"/><parent link="ewalker_link7"/><child link="ewalker_tcp"/>
  </joint>
</robot>
